KW_PROCEDURE procedure
ID pipelineComplexo
LPAREN (
ID id
COMMA ,
ID peso
RPAREN )
KW_LOCAL local
ID estado
COMMA ,
ID idInterno
COMMA ,
ID pesoInterno
ID idInterno
OP_ASGN :=
ID id
ID pesoInterno
OP_ASGN :=
ID peso
KW_IF if
KW_NOT not
ID sistemaIniciado
LPAREN (
RPAREN )
OP_EQ =
ID checarTrava
LPAREN (
ID obterSeguranca
LPAREN (
RPAREN )
RPAREN )
KW_THEN then
LBRACE {
KW_RETURN return
ID abortar
LPAREN (
RPAREN )
RBRACE }
KW_ELSE else
LBRACE {
KW_WHILE while
ID atualizarCiclo
LPAREN (
ID idInterno
RPAREN )
OP_LT <
ID obterMaxCiclos
LPAREN (
ID calcularEspera
LPAREN (
ID idInterno
RPAREN )
RPAREN )
KW_DO do
LBRACE {
KW_IF if
ID validarMetrica
LPAREN (
ID pesoInterno
OP_PLUS +
ID transformar
LPAREN (
ID idInterno
RPAREN )
RPAREN )
KW_THEN then
LBRACE {
KW_WHILE while
ID lerBuffer
LPAREN (
RPAREN )
KW_DO do
LBRACE {
ID pesoInterno
OP_ASGN :=
ID pesoInterno
OP_TIMES *
ID fatorCorrecao
LPAREN (
ID obterMetricaAtual
LPAREN (
RPAREN )
RPAREN )
RBRACE }
RBRACE }
KW_ELSE else
LBRACE {
KW_IF if
ID logarErro
LPAREN (
ID gerarMensagem
LPAREN (
ID idInterno
RPAREN )
RPAREN )
KW_THEN then
LBRACE {
ID idInterno
OP_ASGN :=
ID redefinirId
LPAREN (
ID idInterno
COMMA ,
ID puxarBackup
LPAREN (
RPAREN )
RPAREN )
RBRACE }
RBRACE }
RBRACE }
RBRACE }
KW_RETURN return
ID verificarSucessoFinal
LPAREN (
ID idInterno
COMMA ,
ID finalizarPeso
LPAREN (
ID pesoInterno
RPAREN )
RPAREN )
KW_END end
$ $
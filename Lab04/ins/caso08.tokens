KW_PROCEDURE procedure
ID calcularTaxa
LPAREN (
ID tipo
RPAREN )
KW_IF if
ID estaAtivo
LPAREN (
ID tipo
RPAREN )
KW_THEN then
LBRACE {
KW_IF if
ID obterDesconto
LPAREN (
RPAREN )
OP_GT >
INT_LIT 50
KW_THEN then
LBRACE {
KW_RETURN return
ID aplicarBonus
LPAREN (
ID total
LPAREN (
RPAREN )
OP_PLUS +
INT_LIT 10
RPAREN )
RBRACE }
RBRACE }
KW_END end
$ $
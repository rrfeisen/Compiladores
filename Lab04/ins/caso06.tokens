KW_PROCEDURE procedure
ID avaliar
LPAREN (
ID x
RPAREN )
KW_LOCAL local
ID localX
ID localX
OP_ASGN :=
ID x
KW_IF if
ID checar
LPAREN (
ID localX
RPAREN )
OP_LT <
ID limite
LPAREN (
RPAREN )
KW_THEN then
LBRACE {
KW_RETURN return
ID verificarAtalho
LPAREN (
ID localX
RPAREN )
RBRACE }
KW_ELSE else
LBRACE {
ID localX
OP_ASGN :=
ID localX
OP_TIMES *
ID recalcular
LPAREN (
ID localX
RPAREN )
RBRACE }
KW_END end
$ $
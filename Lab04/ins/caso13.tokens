KW_PROCEDURE procedure
ID simular
LPAREN (
ID passos
RPAREN )
KW_LOCAL local
ID contadorPassos
ID contadorPassos
OP_ASGN :=
ID passos
KW_WHILE while
ID contadorPassos
OP_GT >
ID obterMinimo
LPAREN (
RPAREN )
KW_DO do
LBRACE {
KW_IF if
ID checarCondicao
LPAREN (
ID contadorPassos
OP_PLUS +
ID calcularDelta
LPAREN (
RPAREN )
RPAREN )
KW_THEN then
LBRACE {
ID contadorPassos
OP_ASGN :=
ID contadorPassos
OP_MINUS -
ID extrairPasso
LPAREN (
RPAREN )
RBRACE }
KW_ELSE else
LBRACE {
ID contadorPassos
OP_ASGN :=
ID contadorPassos
OP_DIV /
ID aplicarFator
LPAREN (
ID obterDivisor
LPAREN (
ID contadorPassos
RPAREN )
COMMA ,
ID retornarInercia
LPAREN (
RPAREN )
RPAREN )
RBRACE }
RBRACE }
KW_RETURN return
ID obterResultadoFinal
LPAREN (
RPAREN )
KW_END end
$ $
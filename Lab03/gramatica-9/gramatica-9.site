block -> LBRACE stmt_list RBRACE
block -> LBRACE RBRACE
expr -> assign_expr
assign_expr -> or_expr OP_ASGN assign_expr
assign_expr -> or_expr OP_PLUS_ASGN assign_expr
assign_expr -> or_expr OP_MINUS_ASGN assign_expr
assign_expr -> or_expr

KW_PROCEDURE procedure
ID iguaisFloat
LPAREN (
ID a
COMMA ,
ID b
RPAREN )
KW_LOCAL local
ID resultado
KW_IF if
ID a
OP_EQ =
ID b
KW_THEN then
LBRACE {
ID resultado
OP_ASGN :=
INT_LIT 1
RBRACE }
KW_ELSE else
LBRACE {
ID resultado
OP_ASGN :=
INT_LIT 0
RBRACE }
KW_RETURN return
ID resultado
KW_END end
$ $

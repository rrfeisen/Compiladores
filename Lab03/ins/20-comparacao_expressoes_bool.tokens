KW_PROCEDURE procedure
ID menorSoma
LPAREN (
ID a
COMMA ,
ID b
COMMA ,
ID c
RPAREN )
KW_LOCAL local
ID resultado
ID resultado
OP_ASGN :=
KW_IF if
LPAREN (
ID a
OP_PLUS +
ID b
RPAREN )
OP_LT <
LPAREN (
ID c
OP_TIMES *
INT_LIT 2
RPAREN )
KW_THEN then
INT_LIT 1
KW_ELSE else
INT_LIT 0
KW_RETURN return
ID resultado
KW_END end

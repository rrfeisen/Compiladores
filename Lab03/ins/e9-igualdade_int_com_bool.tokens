COMMENT # AVISO: Erro de tipo no original - comparacao == entre INT e BOOL.
COMMENT # Em Icon nao ha verificacao de tipo; a comparacao numerica e realizada.
KW_PROCEDURE procedure
ID erroIgualdadeTiposMistos
LPAREN (
ID x
COMMA ,
ID b
RPAREN )
KW_LOCAL local
ID resultado
ID resultado
OP_ASGN :=
KW_IF if
ID x
OP_EQ =
ID b
KW_THEN then
INT_LIT 1
KW_ELSE else
INT_LIT 0
KW_RETURN return
ID resultado
KW_END end

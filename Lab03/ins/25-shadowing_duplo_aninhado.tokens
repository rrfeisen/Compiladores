COMMENT # SHADOWING DUPLO: 'v' e 'w' eram sombreados em blocos aninhados.
COMMENT # Em Icon, renomeamos para v0/v1 e w0/w2 para preservar a semantica.
COMMENT # Com a=3, b=4: v0=30, w0=5, v1=10, w2=20 -> retorna 20.
KW_PROCEDURE procedure
ID sombraDupla
LPAREN (
ID a
COMMA ,
ID b
RPAREN )
KW_LOCAL local
ID v0
COMMA ,
ID w0
COMMA ,
ID v1
COMMA ,
ID w2
ID v0
OP_ASGN :=
ID a
OP_TIMES *
INT_LIT 10
ID w0
OP_ASGN :=
ID b
OP_PLUS +
INT_LIT 1
ID v1
OP_ASGN :=
ID w0
OP_TIMES *
INT_LIT 2
ID w2
OP_ASGN :=
ID v1
OP_PLUS +
ID v1
KW_RETURN return
ID w2
KW_END end

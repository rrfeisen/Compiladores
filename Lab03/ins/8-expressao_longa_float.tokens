KW_PROCEDURE procedure
ID calcular
LPAREN (
ID a
COMMA ,
ID b
COMMA ,
ID n
RPAREN )
KW_LOCAL local
ID resultado
ID resultado
OP_ASGN :=
LPAREN (
ID a
OP_PLUS +
ID b
RPAREN )
OP_TIMES *
REAL_LIT 2.0
OP_MINUS -
LPAREN (
ID a
OP_DIV /
ID b
RPAREN )
OP_PLUS +
ID n
OP_TIMES *
REAL_LIT 0.5
KW_RETURN return
ID resultado
KW_END end

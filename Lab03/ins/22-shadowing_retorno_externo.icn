# SHADOWING — o return esta no escopo EXTERNO, portanto retorna resultado_ext.
# Em Icon, renomeamos a variavel interna para preservar a semantica:
# resultado_ext = x * 100 e o que e retornado (nao resultado_inner).
# Com x=5: retorna 500.
procedure sombraRetornoExterno(x)
  local resultado_ext, resultado_inner
  resultado_ext   := x * 100
  resultado_inner := x * 1
  return resultado_ext
end

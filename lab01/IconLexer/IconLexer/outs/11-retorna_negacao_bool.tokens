COMMENT # Negacao logica: inverte 1 para 0 e 0 para 1.
KW_PROCEDURE procedure
ID inverte
LPAREN (
ID b
RPAREN )
KW_LOCAL local
ID resultado
ID resultado
OP_ASGN :=
KW_IF if
ID b
OP_EQ =
INT_LIT 0
KW_THEN then
INT_LIT 1
KW_ELSE else
INT_LIT 0
KW_RETURN return
ID resultado
KW_END end

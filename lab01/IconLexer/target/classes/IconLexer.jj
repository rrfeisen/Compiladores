options {
    STATIC = false;
    IGNORE_CASE = false;
}

PARSER_BEGIN(IconLexer)

import java.io.*;

public class IconLexer {

    static String nomeClasse(int kind) {
        switch (kind) {
            case COMMENT:           return "COMMENT";
            case KW_AMP:            return "KW_AMP";
            case KW_BREAK:          return "KW_BREAK";
            case KW_BY:             return "KW_BY";
            case KW_CASE:           return "KW_CASE";
            case KW_CREATE:         return "KW_CREATE";
            case KW_DEFAULT:        return "KW_DEFAULT";
            case KW_DO:             return "KW_DO";
            case KW_ELSE:           return "KW_ELSE";
            case KW_END:            return "KW_END";
            case KW_EVERY:          return "KW_EVERY";
            case KW_FAIL:           return "KW_FAIL";
            case KW_GLOBAL:         return "KW_GLOBAL";
            case KW_IF:             return "KW_IF";
            case KW_INITIAL:        return "KW_INITIAL";
            case KW_INVOCABLE:      return "KW_INVOCABLE";
            case KW_LINK:           return "KW_LINK";
            case KW_LOCAL:          return "KW_LOCAL";
            case KW_NEXT:           return "KW_NEXT";
            case KW_NOT:            return "KW_NOT";
            case KW_OF:             return "KW_OF";
            case KW_PROCEDURE:      return "KW_PROCEDURE";
            case KW_RECORD:         return "KW_RECORD";
            case KW_REPEAT:         return "KW_REPEAT";
            case KW_RETURN:         return "KW_RETURN";
            case KW_STATIC:         return "KW_STATIC";
            case KW_SUSPEND:        return "KW_SUSPEND";
            case KW_THEN:           return "KW_THEN";
            case KW_TO:             return "KW_TO";
            case KW_UNTIL:          return "KW_UNTIL";
            case KW_WHILE:          return "KW_WHILE";
            case ID:                return "ID";
            case INT_LIT:           return "INT_LIT";
            case REAL_LIT:          return "REAL_LIT";
            case STRING_LIT:        return "STRING_LIT";
            case CSET_LIT:          return "CSET_LIT";
            case OP_SNEQ2_ASGN:     return "OP_SNEQ2_ASGN";
            case OP_SEQ2_ASGN:      return "OP_SEQ2_ASGN";
            case OP_LCAT_ASGN:      return "OP_LCAT_ASGN";
            case OP_SGE_ASGN:       return "OP_SGE_ASGN";
            case OP_SLE_ASGN:       return "OP_SLE_ASGN";
            case OP_SNEQ_ASGN:      return "OP_SNEQ_ASGN";
            case OP_SEQ_ASGN:       return "OP_SEQ_ASGN";
            case OP_CAT_ASGN:       return "OP_CAT_ASGN";
            case OP_SGT_ASGN:       return "OP_SGT_ASGN";
            case OP_SLT_ASGN:       return "OP_SLT_ASGN";
            case OP_NEQ_ASGN:       return "OP_NEQ_ASGN";
            case OP_GE_ASGN:        return "OP_GE_ASGN";
            case OP_LE_ASGN:        return "OP_LE_ASGN";
            case OP_GT_ASGN:        return "OP_GT_ASGN";
            case OP_LT_ASGN:        return "OP_LT_ASGN";
            case OP_EQ_ASGN:        return "OP_EQ_ASGN";
            case OP_OR_ASGN:        return "OP_OR_ASGN";
            case OP_QUEST_ASGN:     return "OP_QUEST_ASGN";
            case OP_BANG_ASGN:      return "OP_BANG_ASGN";
            case OP_AT_ASGN:        return "OP_AT_ASGN";
            case OP_POW_ASGN:       return "OP_POW_ASGN";
            case OP_MOD_ASGN:       return "OP_MOD_ASGN";
            case OP_DIV_ASGN:       return "OP_DIV_ASGN";
            case OP_TIMES_ASGN:     return "OP_TIMES_ASGN";
            case OP_MINUS_ASGN:     return "OP_MINUS_ASGN";
            case OP_PLUS_ASGN:      return "OP_PLUS_ASGN";
            case OP_SWAP:           return "OP_SWAP";
            case OP_ASGN:           return "OP_ASGN";
            case OP_REVSWAP:        return "OP_REVSWAP";
            case OP_REVASGN:        return "OP_REVASGN";
            case OP_SNEQ2:          return "OP_SNEQ2";
            case OP_SEQ2:           return "OP_SEQ2";
            case OP_SNEQ:           return "OP_SNEQ";
            case OP_SEQ:            return "OP_SEQ";
            case OP_SGE:            return "OP_SGE";
            case OP_SLE:            return "OP_SLE";
            case OP_SGT:            return "OP_SGT";
            case OP_SLT:            return "OP_SLT";
            case OP_NEQ:            return "OP_NEQ";
            case OP_GE:             return "OP_GE";
            case OP_LE:             return "OP_LE";
            case OP_GT:             return "OP_GT";
            case OP_LT:             return "OP_LT";
            case OP_EQ:             return "OP_EQ";
            case OP_LCAT:           return "OP_LCAT";
            case OP_CAT:            return "OP_CAT";
            case OP_PLUS:           return "OP_PLUS";
            case OP_MINUS:          return "OP_MINUS";
            case OP_TIMES:          return "OP_TIMES";
            case OP_DIV:            return "OP_DIV";
            case OP_MOD:            return "OP_MOD";
            case OP_POW:            return "OP_POW";
            case OP_OR:             return "OP_OR";
            case OP_AND:            return "OP_AND";
            case OP_AT:             return "OP_AT";
            case OP_BANG:           return "OP_BANG";
            case OP_QUEST:          return "OP_QUEST";
            case OP_TILDE:          return "OP_TILDE";
            case OP_BACKSLASH:      return "OP_BACKSLASH";
            case OP_DOT:            return "OP_DOT";
            case COLON:             return "COLON";
            case SEMICOLON:         return "SEMICOLON";
            case COMMA:             return "COMMA";
            case LPAREN:            return "LPAREN";
            case RPAREN:            return "RPAREN";
            case LBRACKET:          return "LBRACKET";
            case RBRACKET:          return "RBRACKET";
            case LBRACE:            return "LBRACE";
            case RBRACE:            return "RBRACE";
            default:                return "DESCONHECIDO";
        }
    }

    public static void main(String[] args) {
        InputStream entrada = System.in;
        if (args.length > 0) {
            try {
                entrada = new FileInputStream(args[0]);
            } catch (FileNotFoundException e) {
                System.err.println("Erro: arquivo nao encontrado: " + args[0]);
                System.exit(1);
            }
        }

        SimpleCharStream fluxo = new SimpleCharStream(entrada, 1, 1);
        IconLexerTokenManager tm = new IconLexerTokenManager(fluxo);
        Token tok;
        try {
            while (true) {
                tok = tm.getNextToken();
                if (tok.kind == EOF) break;
                System.out.println(nomeClasse(tok.kind) + " " + tok.image);
            }
        } catch (TokenMgrError e) {
            System.err.println("Erro lexico: " + e.getMessage());
            System.exit(1);
        }
    }
}

PARSER_END(IconLexer)

SKIP: {
    " " | "\t" | "\r" | "\n"
}

TOKEN: {
    <COMMENT: "#" (~["\n","\r"])* >
}

TOKEN: {
    <KW_AMP: "&" ["a"-"z","A"-"Z"] (["a"-"z","A"-"Z","0"-"9","_"])* >
}

TOKEN: {
    <KW_BREAK:      "break">
  | <KW_BY:         "by">
  | <KW_CASE:       "case">
  | <KW_CREATE:     "create">
  | <KW_DEFAULT:    "default">
  | <KW_DO:         "do">
  | <KW_ELSE:       "else">
  | <KW_END:        "end">
  | <KW_EVERY:      "every">
  | <KW_FAIL:       "fail">
  | <KW_GLOBAL:     "global">
  | <KW_IF:         "if">
  | <KW_INITIAL:    "initial">
  | <KW_INVOCABLE:  "invocable">
  | <KW_LINK:       "link">
  | <KW_LOCAL:      "local">
  | <KW_NEXT:       "next">
  | <KW_NOT:        "not">
  | <KW_OF:         "of">
  | <KW_PROCEDURE:  "procedure">
  | <KW_RECORD:     "record">
  | <KW_REPEAT:     "repeat">
  | <KW_RETURN:     "return">
  | <KW_STATIC:     "static">
  | <KW_SUSPEND:    "suspend">
  | <KW_THEN:       "then">
  | <KW_TO:         "to">
  | <KW_UNTIL:      "until">
  | <KW_WHILE:      "while">
}

TOKEN: {
    <ID: ["a"-"z","A"-"Z","_"] (["a"-"z","A"-"Z","0"-"9","_"])* >
}

TOKEN: {
    <#EXPOENTE: ["e","E"] (["+","-"])? (["0"-"9"])+>
  | <REAL_LIT:
        (["0"-"9"])+ "." (["0"-"9"])* (<EXPOENTE>)?
      | "." (["0"-"9"])+ (<EXPOENTE>)?
      | (["0"-"9"])+ <EXPOENTE>
    >
  | <INT_LIT:
        (["0"-"9"])+ "r" (["0"-"9","a"-"z","A"-"Z"])+
      | (["0"-"9"])+
    >
}

TOKEN: {
    <STRING_LIT:
        "\""
        ( ~["\"","\\","\n","\r"]
        | "\\" ~[]
        )*
        "\""
    >
}

TOKEN: {
    <CSET_LIT:
        "'"
        ( ~["'","\\","\n","\r"]
        | "\\" ~[]
        )*
        "'"
    >
}

TOKEN: {
    <OP_SNEQ2_ASGN: "~===:=">
  | <OP_SEQ2_ASGN:  "===:=">
  | <OP_LCAT_ASGN:  "|||:=">
  | <OP_CAT_ASGN:   "||:=">
  | <OP_SGE_ASGN:   ">>=:=">
  | <OP_SLE_ASGN:   "<<=:=">
  | <OP_SNEQ_ASGN:  "~==:=">
  | <OP_SEQ_ASGN:   "==:=">
  | <OP_SGT_ASGN:   ">>:=">
  | <OP_SLT_ASGN:   "<<:=">
  | <OP_NEQ_ASGN:   "~=:=">
  | <OP_GE_ASGN:    ">=:=">
  | <OP_LE_ASGN:    "<=:=">
  | <OP_GT_ASGN:    ">:=">
  | <OP_LT_ASGN:    "<:=">
  | <OP_EQ_ASGN:    "=:=">
  | <OP_OR_ASGN:    "|:=">
  | <OP_QUEST_ASGN: "?:=">
  | <OP_BANG_ASGN:  "!:=">
  | <OP_AT_ASGN:    "@:=">
  | <OP_POW_ASGN:   "^:=">
  | <OP_MOD_ASGN:   "%:=">
  | <OP_DIV_ASGN:   "/:=">
  | <OP_TIMES_ASGN: "*:=">
  | <OP_MINUS_ASGN: "-:=">
  | <OP_PLUS_ASGN:  "+:=">
}

TOKEN: {
    <OP_SWAP:    ":=:">
  | <OP_ASGN:    ":=">
  | <OP_REVSWAP: "<->">
  | <OP_REVASGN: "<-">
}

TOKEN: {
    <OP_SNEQ2: "~===">
  | <OP_SEQ2:  "===">
}

TOKEN: {
    <OP_SNEQ: "~==">
  | <OP_SEQ:  "==">
  | <OP_SGE:  ">>=">
  | <OP_SLE:  "<<=">
  | <OP_SGT:  ">>">
  | <OP_SLT:  "<<">
}

TOKEN: {
    <OP_NEQ: "~=">
  | <OP_GE:  ">=">
  | <OP_LE:  "<=">
  | <OP_GT:  ">">
  | <OP_LT:  "<">
  | <OP_EQ:  "=">
}

TOKEN: {
    <OP_LCAT: "|||">
  | <OP_CAT:  "||">
}

TOKEN: {
    <OP_PLUS:  "+">
  | <OP_MINUS: "-">
  | <OP_TIMES: "*">
  | <OP_DIV:   "/">
  | <OP_MOD:   "%">
  | <OP_POW:   "^">
}

TOKEN: {
    <OP_OR:        "|">
  | <OP_AND:       "&">
  | <OP_AT:        "@">
  | <OP_BANG:      "!">
  | <OP_QUEST:     "?">
  | <OP_TILDE:     "~">
  | <OP_BACKSLASH: "\\">
  | <OP_DOT:       ".">
}

TOKEN: {
    <COLON:     ":">
  | <SEMICOLON: ";">
  | <COMMA:     ",">
  | <LPAREN:    "(">
  | <RPAREN:    ")">
  | <LBRACKET:  "[">
  | <RBRACKET:  "]">
  | <LBRACE:    "{">
  | <RBRACE:    "}">
}

void Dummy(): {}
{
    <EOF>
}
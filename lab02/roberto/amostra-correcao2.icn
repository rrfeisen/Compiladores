record ponto_t(x, y)

record triangulo_t(a, b, c, cor)

procedure func(v, n, T)
    local res, i, temp

    if n <= 0 then {
        return 1.0
    } else if n = 1 then {
        return 1.01 + v[0].x / 1.0e2 + v[0].y / 0.1e-2 - T.a.x * T.a.x + T.b.y * T.c.x
    }

    res := 0.25e-13
    i := n - 1

    while i >= 0 & v[i].x > 0 do {
        temp := v[i].y * v[i].x % 123
        if temp < 0.0 then {
            res -:= res * 2.0e-2 + func(v, n - 1, T) * temp - T.a.y * T.cor
        } else {
            res +:= res * 0.3e3 + func(v, n - 2, T) * temp + T.c.x * T.cor
            write("Estranho, ne?\n")
        }
        i -:= 1
    }
    return res
end

procedure F2(T)
    local A, soma, total
    A := 0

    if (T.a.x >= 10 | T.b.y > 20 | T.a.y < 30 | T.b.x <= 50) & not (T.c.x ~= 90 | T.c.y = 0) then {
        return 10 % 3
    } else {
        A := 1
    }

    while A < 10 do {
        total := 0
        total +:= T.c.x * T.c.y
        total +:= T.b.x * T.a.y
        total +:= T.a.x * T.b.y
        soma[A] := total % 100
        A := A + 1
    }
end

procedure fatorialA(n)
    if n <= 1 then {
        return 1
    }
    return n * fatorialA(n - 1)
end

procedure fatorialB(n)
    local a
    a := n - 1
    if n <= 1 then {
        return 1
    }
    return n * fatorialB(a)
end

procedure fatorialC(n, P)
    if n <= 1 then {
        return 1
    }
    return fatorialC(n - 1, P * n)
end

procedure fatorialD(n, P)
    local a, b
    a := n - 1
    b := P * n
    if n <= 1 then {
        return 1
    }
    return fatorialD(a, b)
end

procedure fatorialE(n, P)
    local a, b
    if n <= 1 then {
        return 1
    } else {
        a := n - 1
        b := P * n
        return fatorialD(a, b)
    }
end

procedure C1(a, b)
    if a < b then {
        return 1
    }
    return 2
end

procedure C2(a, b)
    if a <= b then {
        return 1
    }
    return 2
end

procedure C3(a, b)
    if a > b then {
        return 1
    }
    return 2
end

procedure C4(a, b)
    if a >= b then {
        return 1
    }
    return 2
end

procedure C5(a, b)
    if a = b then {
        return 1
    }
    return 2
end

procedure C5(a, b)
    if a ~= b then {
        return 1
    }
    return 2
end

procedure D1(a, b)
    if a ~= b & a < b then {
        return 1
    }
    return 2
end

procedure D2(a, b)
    if not (a ~= b & a < b) then {
        return 1
    }
    return 2
end

procedure D3(a, b)
    if (not (a ~= b & a < b)) | (a + 2 = b) then {
        return 1
    }
    return 2
end

procedure E1(a, b)
    local X
    X := ((not (a ~= b & a < b)) | (a + 2 = b))
    if a ~= b | X | a + 5 = b then {
        a +:= 1
    }
    return 2
end

procedure E2(a, b)
    local X
    X := ((not (a ~= b & a < b)) | (a + 2 = b))
    while a ~= b | X | a + 5 = b do {
        a +:= 1
        while a < b do {
            b -:= 1
        }
    }
    return 2
end

procedure E2(a, b)
    local X
    X := ((not (a ~= b & a < b)) | (a + 2 = b))
    while a ~= b | X | a + 5 = b do {
        a +:= 1
        while fatorialA(a) < b do {
            b -:= 1
        }
    }
    return X | a > 0
end

record ponto_2d_t(x, y)

record ponto_3d_t(x, y, z)

record segmento_2d_t(ini, fim)

record segmento_3d_t(ini, fim)

procedure F1(seg, p)
    local ax, ay, bx, b_y, px, py, abx, aby, apx, apy, ab2, t, qx, qy, dx, dy
    ax := seg.ini.x
    ay := seg.ini.y
    bx := seg.fim.x
    b_y := seg.fim.y
    px := p.x
    py := p.y
    abx := bx - ax
    aby := b_y - ay
    apx := px - ax
    apy := py - ay
    ab2 := abx * abx + aby * aby
    t := (apx * abx + apy * aby) / ab2

    if t < 0.0 then {
        t := 0.0
    }
    if t > 1.0 then {
        t := 1.0
    }

    qx := ax + t * abx
    qy := ay + t * aby
    dx := px - qx
    dy := py - qy

    return sqrt(dx * dx + dy * dy)
end

procedure dist2(a, b)
    local dx, dy
    dx := a.x - b.x
    dy := a.y - b.y
    return dx * dx + dy * dy
end

procedure F2(seg, p)
    local ax, ay, bx, b_y, px, py, abx, aby, apx, apy, bpx, bpy, dot1, dot2, cross
    ax := seg.ini.x
    ay := seg.ini.y
    bx := seg.fim.x
    b_y := seg.fim.y
    px := p.x
    py := p.y
    abx := bx - ax
    aby := b_y - ay
    apx := px - ax
    apy := py - ay
    bpx := px - bx
    bpy := py - b_y
    dot1 := apx * abx + apy * aby
    dot2 := bpx * abx + bpy * aby

    if dot1 <= 0 then {
        return dist2(p, seg.ini)
    }
    if dot2 >= 0 then {
        return dist2(p, seg.fim)
    }

    cross := abx * apy - aby * apx
    return (cross * cross) / (abx * abx + aby * aby)
end

procedure area_poligono(p, n)
    local soma, i, j
    soma := 0
    i := 0
    while i < n do {
        j := (i + 1) % n
        soma +:= p[i].x * p[j].y - p[j].x * p[i].y
        i +:= 1
    }

    if soma < 0 then {
        soma := 0 - soma
    }

    return soma / 2.0
end

procedure area_pol()
    local poli
    return area_poligono(poli, 150)
end